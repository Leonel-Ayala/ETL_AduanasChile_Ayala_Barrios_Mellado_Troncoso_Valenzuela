# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - PROYECTO ETL ADUANAS DE CHILE
# ==============================================================================
# Copie este archivo como .env y ajuste sus credenciales antes de iniciar Docker.

# Configuración de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_contrasena_segura
POSTGRES_DB=aduanas_dw

# Puerto del HOST para conectarse desde DBeaver (5433 evita choque con un PostgreSQL local).
# Dentro de Docker los contenedores siempre usan 5432.
POSTGRES_PORT=5433

# Clave de cifrado Fernet para Apache Airflow (Connections seguras)
# Genere una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Configuración de Apache Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.1
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=false
